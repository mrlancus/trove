{
  "manifest_version": 3,
  "name": "Save to Trove",
  "short_name": "Trove",
  "version": "0.1.0",
  "description": "Save pages, selections and links to your Trove, end-to-end encrypted.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Save to Trove" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" } },
    "save-page": { "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" }, "description": "Save the current page without opening the popup" }
  }
}
